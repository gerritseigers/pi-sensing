[Unit]
Description=Pi Edge Sensing: data collector (UTC minute sampling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=staldemo
WorkingDirectory=/home/staldemo/Projects/pi-sensing
EnvironmentFile=/home/staldemo/Projects/pi-sensing/.env
Environment=GPIO_BACKENDS=lgpio,rpi
Environment=PULSE_SKIP_PIGPIO=1
Environment=LGPIO_CHIP_PRIORITY=4,0,10,11,12,13
ExecStart=/home/staldemo/Projects/pi-sensing/.venv/bin/python /home/staldemo/Projects/pi-sensing/src/mainApp.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target